<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smarthotel.controller.AdminController" styleClass="page">
 <top><HBox alignment="CENTER_LEFT" spacing="16" styleClass="topbar"><VBox spacing="2"><Label text="SMART HOTEL" styleClass="top-brand"/><Label text="Admin / Staff Management Console" styleClass="nav-title"/></VBox><Region HBox.hgrow="ALWAYS"/><Label fx:id="adminName" text="Administrator" styleClass="nav-user"/><Button text="Refresh" onAction="#refresh" styleClass="secondary"/><Button text="Logout" onAction="#logout" styleClass="danger"/></HBox></top>
 <center><ScrollPane fx:id="contentScroll" fitToWidth="true"><VBox spacing="18" styleClass="content">
  <VBox spacing="3"><Label text="Management Dashboard" styleClass="title"/><Label text="Manage rooms, room photos, bookings, services, customer ratings and payments." styleClass="hint"/></VBox>
  <HBox spacing="12" styleClass="stats-row"><VBox styleClass="stat"><Label text="TOTAL ROOMS" styleClass="stat-label"/><Label fx:id="roomsCount" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat"><Label text="AVAILABLE" styleClass="stat-label"/><Label fx:id="availableCount" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat"><Label text="OCCUPIED" styleClass="stat-label"/><Label fx:id="occupiedCount" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat"><Label text="TODAY IN / OUT" styleClass="stat-label"/><Label fx:id="todayCount" text="0 / 0" styleClass="stat-number"/></VBox><VBox styleClass="stat"><Label text="TOTAL BOOKINGS" styleClass="stat-label"/><Label fx:id="resCount" text="0" styleClass="stat-number"/></VBox><VBox styleClass="stat"><Label text="REVENUE" styleClass="stat-label"/><Label fx:id="revenueCount" text="0" styleClass="stat-number"/></VBox></HBox>
  <TabPane fx:id="mainTabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
   <Tab text="Rooms"><VBox spacing="10" styleClass="card"><HBox alignment="CENTER_LEFT" spacing="10"><VBox spacing="2" HBox.hgrow="ALWAYS"><Label text="Room Management" styleClass="section"/><Label text="Add room photos that customers can open and view before booking." styleClass="hint"/></VBox><Button fx:id="addRoomBtn" text="+ Add Room" onAction="#toggleRoomForm" styleClass="primary"/></HBox>
    <TableView fx:id="roomTable" prefHeight="260" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="numCol" text="Room"/><TableColumn fx:id="catCol" text="Type"/><TableColumn fx:id="priceCol" text="Price / Night"/><TableColumn fx:id="statCol" text="Status"/></columns></TableView>
    <VBox fx:id="roomFormPanel" spacing="10" styleClass="form-panel" visible="false" managed="false"><Label fx:id="roomFormTitle" text="Add New Room" styleClass="section"/>
     <GridPane hgap="10" vgap="10"><columnConstraints><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints><TextField fx:id="roomNo" promptText="Room number"/><ComboBox fx:id="category" promptText="Room type" GridPane.columnIndex="1"/><TextField fx:id="price" promptText="Price per night" GridPane.columnIndex="2"/><TextField fx:id="capacity" promptText="Capacity" GridPane.columnIndex="3"/><TextField fx:id="facilities" promptText="Facilities" GridPane.rowIndex="1" GridPane.columnSpan="2"/><ComboBox fx:id="roomStatus" promptText="Status" GridPane.rowIndex="1" GridPane.columnIndex="2"/></GridPane>
     <HBox spacing="8"><TextField fx:id="photoPath" promptText="Room photo path" HBox.hgrow="ALWAYS"/><Button text="Choose Photo" onAction="#choosePhoto" styleClass="secondary"/></HBox><Label fx:id="roomPhotoStatus" text="No photo selected" styleClass="hint"/><HBox spacing="8"><Button text="Save Room" onAction="#saveRoom" styleClass="primary"/><Button text="Delete Room" onAction="#deleteRoom" styleClass="danger"/><Button text="Cancel" onAction="#cancelRoomForm" styleClass="secondary"/></HBox>
    </VBox>
   </VBox></Tab>
   <Tab text="Customers"><VBox spacing="10" styleClass="card"><Label text="Customer Management" styleClass="section"/><HBox spacing="8"><TextField fx:id="customerSearch" promptText="Search name, email or phone" HBox.hgrow="ALWAYS"/><Button text="Search" onAction="#searchCustomers" styleClass="primary"/></HBox><TableView fx:id="customerTable" prefHeight="220"><columns><TableColumn fx:id="customerNameCol" text="Name"/><TableColumn fx:id="customerEmailCol" text="Email"/><TableColumn fx:id="customerPhoneCol" text="Phone"/></columns></TableView><GridPane hgap="8" vgap="8"><columnConstraints><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints><TextField fx:id="customerName" promptText="Full name"/><TextField fx:id="customerEmail" promptText="Email" GridPane.columnIndex="1"/><TextField fx:id="customerPhone" promptText="Phone" GridPane.columnIndex="2"/><TextField fx:id="customerAddress" promptText="Address" GridPane.columnIndex="3"/><TextField fx:id="customerUsername" promptText="Login username" GridPane.rowIndex="1"/><PasswordField fx:id="customerPassword" promptText="Password (6+ chars)" GridPane.rowIndex="1" GridPane.columnIndex="1"/></GridPane><HBox spacing="8"><Button text="Add Customer Account" onAction="#addCustomer" styleClass="primary"/><Button text="Update Customer" onAction="#saveCustomer" styleClass="secondary"/><Button text="Delete Customer" onAction="#deleteCustomer" styleClass="danger"/></HBox><Label text="Selected customer's booking history" styleClass="section"/><TextArea fx:id="customerHistory" editable="false" prefRowCount="5" wrapText="true"/></VBox></Tab>
   <Tab text="Reservations"><VBox spacing="10" styleClass="card"><Label text="Reservation Management" styleClass="section"/><HBox spacing="8"><TextField fx:id="reservationSearch" promptText="Search booking ID, customer, room or status" HBox.hgrow="ALWAYS"/><Button text="Search" onAction="#searchReservations" styleClass="primary"/></HBox><TableView fx:id="reservationTable" prefHeight="280"><columns><TableColumn fx:id="reservationIdCol" text="ID"/><TableColumn fx:id="reservationCustomerCol" text="Customer"/><TableColumn fx:id="reservationRoomCol" text="Room"/><TableColumn fx:id="reservationDateCol" text="Dates"/><TableColumn fx:id="reservationGuestsCol" text="Guests"/><TableColumn fx:id="reservationTotalCol" text="Total"/><TableColumn fx:id="reservationStatusCol" text="Status"/></columns></TableView><GridPane hgap="8" vgap="8"><columnConstraints><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints><DatePicker fx:id="reservationIn" promptText="Check-in"/><DatePicker fx:id="reservationOut" promptText="Check-out" GridPane.columnIndex="1"/><Spinner fx:id="reservationGuests" GridPane.columnIndex="2"/></GridPane><HBox spacing="7"><Button text="Confirm" onAction="#confirmReservation" styleClass="primary"/><Button text="Modify" onAction="#modifyReservation" styleClass="secondary"/><Button text="Cancel" onAction="#cancelReservation" styleClass="danger"/><Button text="Check-in" onAction="#checkIn" styleClass="primary"/><Button text="Check-out" onAction="#checkOut" styleClass="secondary"/></HBox></VBox></Tab>
   <Tab text="Extra Services"><VBox spacing="10" styleClass="card"><Label text="Service Requests &amp; Approval" styleClass="section"/><Label text="Approve or reject customer requests and send a message. Approved services are added to the booking total." styleClass="hint" wrapText="true"/><TableView fx:id="serviceRequestTable" prefHeight="300"><columns><TableColumn fx:id="serviceRequestIdCol" text="ID"/><TableColumn fx:id="serviceRequestReservationCol" text="Booking"/><TableColumn fx:id="serviceRequestNameCol" text="Service"/><TableColumn fx:id="serviceRequestQtyCol" text="Qty"/><TableColumn fx:id="serviceRequestAmountCol" text="Amount"/><TableColumn fx:id="serviceRequestStatusCol" text="Status"/><TableColumn fx:id="serviceRequestMessageCol" text="Message" prefWidth="280"/></columns></TableView><HBox spacing="10"><ComboBox fx:id="serviceDecision" promptText="Decision"/><TextField fx:id="serviceMessage" promptText="Message to customer" HBox.hgrow="ALWAYS"/><Button text="Save Decision &amp; Send Message" onAction="#decideService" styleClass="primary"/></HBox></VBox></Tab>
   <Tab text="Ratings"><VBox spacing="10" styleClass="card"><Label text="Customer Ratings &amp; Reviews" styleClass="section"/><Label text="All submitted customer ratings are visible here for admin review." styleClass="hint"/><TableView fx:id="reviewTable" prefHeight="360"><columns><TableColumn fx:id="reviewIdCol" text="ID"/><TableColumn fx:id="reviewRatingCol" text="Rating"/><TableColumn fx:id="reviewCustomerCol" text="Customer ID"/><TableColumn fx:id="reviewReservationCol" text="Booking"/><TableColumn fx:id="reviewCommentCol" text="Comment" prefWidth="420"/><TableColumn fx:id="reviewDateCol" text="Date"/></columns></TableView></VBox></Tab>
   <Tab text="API / JSON Demo"><VBox spacing="10" styleClass="card"><Label text="HTTP Request &amp; JSON Parsing Demo" styleClass="section"/><Label text="Fetches live JSON from the internet using Java HttpClient, runs in a fixed thread pool, and parses it with Jackson ObjectMapper." styleClass="hint" wrapText="true"/><Button text="FETCH JSON FROM INTERNET" onAction="#testApi" styleClass="primary"/><Label fx:id="apiStatus" text="Ready to make an HTTP GET request." styleClass="success" wrapText="true"/><Label fx:id="apiQuote" text="Parsed quote: —" styleClass="quote" wrapText="true"/><TextArea fx:id="apiJson" editable="false" prefRowCount="8" wrapText="true" promptText="Raw JSON response will appear here..."/></VBox></Tab>
   <Tab text="Payments"><VBox spacing="10" styleClass="card"><Label text="Payment Management" styleClass="section"/><TableView fx:id="paymentTable" prefHeight="300"><columns><TableColumn fx:id="paymentIdCol" text="ID"/><TableColumn fx:id="paymentReservationCol" text="Reservation"/><TableColumn fx:id="paymentAmountCol" text="Amount"/><TableColumn fx:id="paymentMethodCol" text="Method"/><TableColumn fx:id="paymentStatusCol" text="Status"/></columns></TableView><GridPane hgap="8" vgap="8"><columnConstraints><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints><TextField fx:id="paymentReservationId" promptText="Reservation ID"/><TextField fx:id="paymentAmount" promptText="Amount" GridPane.columnIndex="1"/><ComboBox fx:id="paymentMethod" promptText="Method" GridPane.columnIndex="2"/><ComboBox fx:id="paymentStatus" promptText="Status" GridPane.columnIndex="3"/></GridPane><HBox spacing="8"><Button text="Record Payment" onAction="#recordPayment" styleClass="primary"/><Button text="Update Payment" onAction="#updatePayment" styleClass="secondary"/><Button text="Delete Payment" onAction="#deletePayment" styleClass="danger"/></HBox></VBox></Tab>
  </TabPane>
  <Label fx:id="status" text="Ready." styleClass="success" wrapText="true"/>
 </VBox></ScrollPane></center>
</BorderPane>