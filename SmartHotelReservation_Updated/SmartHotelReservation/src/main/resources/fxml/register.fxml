<?import javafx.scene.layout.VBox?><BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smarthotel.controller.RegisterController" styleClass="page"><center><VBox maxWidth="650" spacing="12" styleClass="card"><children><Label text="Create Customer Account" styleClass="title"/><TextField fx:id="name" promptText="Full name *"/><TextField fx:id="email" promptText="Email *"/><TextField fx:id="phone" promptText="Phone"/><TextField fx:id="address" promptText="Address"/><TextField fx:id="username" promptText="Username *"/><PasswordField fx:id="password" promptText="Password (6+ characters) *"/><HBox spacing="10"><Button text="Create Account" onAction="#create" styleClass="primary"/><Button text="Back to Login" onAction="#back"/></HBox><Label fx:id="message" styleClass="hint"/></children></VBox></center></BorderPane>
